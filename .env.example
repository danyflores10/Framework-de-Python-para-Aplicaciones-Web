# =====================================================================
# Copie este archivo con el nombre .env y ajuste los valores.
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# =====================================================================

# Clave secreta de Flask (firma la sesión y los tokens CSRF).
# Genere una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria

# Motor de base de datos:
#   postgresql -> PostgreSQL (motor principal del proyecto, base Tarea_Flask)
#   mysql      -> MySQL / MariaDB con XAMPP (como en el video)
#   sqlite     -> SQLite, no requiere instalar ningún servidor
DB_MOTOR=postgresql

# Parámetros de PostgreSQL (solo si DB_MOTOR=postgresql).
# POSTGRES_PASSWORD es la contraseña del usuario postgres que se definió
# al instalar PostgreSQL (la misma que pide pgAdmin al conectarse).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=Tarea_Flask

# Parámetros de MySQL / MariaDB (solo si DB_MOTOR=mysql).
# En XAMPP el usuario por defecto es root sin contraseña.
# 127.0.0.1 equivale a localhost y evita demoras de IPv6 en Windows.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=abaco

# Cantidad de cursos por página en el listado.
CURSOS_POR_PAGINA=8
